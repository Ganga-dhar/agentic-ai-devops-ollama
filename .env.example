# Copy this file to .env and adjust the values for your environment.
# The agent loads these at startup via python-dotenv.

# -------------------------------------------------------------------
# Ollama settings
# -------------------------------------------------------------------

# Base URL of the running Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Model to use — must be pulled in Ollama first:
#   ollama pull llama3.2
#   ollama pull mistral
#   ollama pull codellama
OLLAMA_MODEL=llama3.2

# -------------------------------------------------------------------
# Agent behaviour
# -------------------------------------------------------------------

# Set to "true" to see the agent's step-by-step reasoning (ReAct trace).
# Set to "false" for clean output only.
AGENT_VERBOSE=true

# Maximum number of tool-call iterations before the agent gives up.
MAX_ITERATIONS=10
